# Docker Compose deployment template. Copy to .env and replace CHANGE_ME locally.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=mall
# The existing mysql-data volume uses the root account.
MYSQL_USERNAME=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_HOST=mysql
MYSQL_PORT=3306

ACTUATOR_USERNAME=actuator
ACTUATOR_PASSWORD=CHANGE_ME

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=mall
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VIRTUAL_HOST=/
ELASTICSEARCH_URIS=http://elasticsearch:9200

MALL_INTERNAL_TOKEN=CHANGE_ME

# Docker network address. IDEA startup uses the fallback in application.yml.
NACOS_SERVER_ADDR=nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=CHANGE_ME
NACOS_AUTH_TOKEN=CHANGE_ME
NACOS_AUTH_IDENTITY_KEY=CHANGE_ME
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME

MONITOR_USERNAME=monitor
MONITOR_PASSWORD=CHANGE_ME

SA_TOKEN_SIGNING_KEY=CHANGE_ME

# Fixed business image tag. Never use latest.
MALL_IMAGE_TAG=1.0.0
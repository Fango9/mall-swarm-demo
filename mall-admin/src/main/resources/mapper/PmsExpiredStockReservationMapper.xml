<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.fango.mall.admin.mapper.PmsExpiredStockReservationMapper">

    <resultMap id="ExpiredStockReservationResultMap"
               type="cn.fango.mall.mbg.model.PmsStockReservation">
        <id column="id"
            jdbcType="BIGINT"
            property="id"/>

        <result column="reservation_no"
                jdbcType="VARCHAR"
                property="reservationNo"/>

        <result column="sku_id"
                jdbcType="BIGINT"
                property="skuId"/>

        <result column="quantity"
                jdbcType="INTEGER"
                property="quantity"/>

        <result column="status"
                jdbcType="VARCHAR"
                property="status"/>

        <result column="expire_at"
                jdbcType="TIMESTAMP"
                property="expireAt"/>

        <result column="create_time"
                jdbcType="TIMESTAMP"
                property="createTime"/>

        <result column="modify_time"
                jdbcType="TIMESTAMP"
                property="modifyTime"/>
    </resultMap>

    <select id="selectExpiredLockedReservations"
            resultMap="ExpiredStockReservationResultMap">
        SELECT
            id,
            reservation_no,
            sku_id,
            quantity,
            status,
            expire_at,
            create_time,
            modify_time
        FROM pms_stock_reservation
        WHERE status = 'LOCKED'
          AND expire_at IS NOT NULL
          AND expire_at &lt;= #{now,jdbcType=TIMESTAMP}
        ORDER BY expire_at ASC,
                 id ASC
        LIMIT #{limit,jdbcType=INTEGER}
    </select>

    <update id="markReleasedIfExpired">
        UPDATE pms_stock_reservation
        SET status = 'RELEASED',
            expire_at = NULL
        WHERE id = #{reservationId,jdbcType=BIGINT}
          AND status = 'LOCKED'
          AND expire_at IS NOT NULL
          AND expire_at &lt;= #{now,jdbcType=TIMESTAMP}
    </update>

</mapper>